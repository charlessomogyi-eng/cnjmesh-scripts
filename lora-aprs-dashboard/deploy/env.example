# Copy to /opt/lora-aprs-dashboard/.env on the host and fill in.
# The real .env holds a password and never goes into git.

OWN_CALL=K2GIA-10
# Receiver position for the map (decimal degrees, west is negative). Kept here,
# on the Pi, not in the repo. Leave empty to show stations without the receiver.
OWN_LAT=
OWN_LON=

# Syslog from the iGate (web UI -> Syslog: server = this host, port = this port)
SYSLOG_BIND=0.0.0.0
SYSLOG_PORT=1514
# Only accept lines from the iGate's address (space separated; empty = any)
# Check the address is still current: lines from any other address are
# dropped without a message.
SYSLOG_ALLOW=10.0.0.74
# Pass every accepted datagram on, unchanged (space separated host:port).
# On cnjmesh3: the Discord bridge on cnjmesh1 keeps getting every line.
SYSLOG_FORWARD=10.0.0.181:1514

# MQTT feed from the iGate (leave MQTT_HOST empty to run on syslog alone).
# The program only subscribes. It never publishes.
MQTT_HOST=10.0.0.181
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=aprs-k2gia-10

HTTP_BIND=0.0.0.0
HTTP_PORT=8090

DB_PATH=/var/lib/lora-aprs-dashboard/lora-aprs.db
RETENTION_DAYS=90

# Free text for the page's "Local setup" tab (empty lines are left off).
# No coordinates or street address if anyone else will see the page.
SETUP_HARDWARE=
SETUP_ANTENNA=
SETUP_NOTES=

# Must match the iGate's receive settings (used for airtime and SNR colours)
LORA_SF=12
LORA_BW=125000
LORA_CR=5
LORA_PREAMBLE=8
