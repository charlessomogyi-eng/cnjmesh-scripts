+def alert_wide_config():
+    # optional [location] alertStateArea = NJ  and  alertFIPS = 34023,34025,...  (county FIPS, comma separated)
+    # Both must be set, otherwise the broadcast keeps using the single home point only.
+    try:
+        sec = my_settings.config['location']
+        area = sec.get('alertStateArea', '').strip().upper()
+        fips = {c.strip() for c in sec.get('alertFIPS', '').split(',') if c.strip()}
+    except Exception:
+        return "", set()
+    if not area or not fips:
+        return "", set()
+    return area, fips
+
+def alert_entry_fips(entry):
+    # county FIPS codes ("34023") of one NWS atom <entry>. NWS lists them in cap:geocode as six-digit
+    # SAME codes ("034023"); this takes any six-digit number there, whatever the valueName is called.
+    codes = set()
+    for g in entry.getElementsByTagName("cap:geocode"):
+        for v in g.getElementsByTagName("value"):
+            if v.childNodes:
+                for tok in v.childNodes[0].nodeValue.split():
+                    if tok.isdigit() and len(tok) == 6:
+                        codes.add(tok[1:])
+    return codes
+
+def alert_entries(point_text, wide_text="", fips=()):
+    # entries from the home-point feed (always) plus entries from the statewide feed that touch one of
+    # the wanted counties. An alert in both feeds is returned once (matched by its <id>).
+    seen = set()
+    for text, wide in ((point_text, False), (wide_text, True)):
+        if not text:
+            continue
+        for e in xml.dom.minidom.parseString(text).getElementsByTagName("entry"):
+            ids = e.getElementsByTagName("id")
+            key = ids[0].childNodes[0].nodeValue if ids and ids[0].childNodes else e.toxml()
+            if key in seen:
+                continue
+            if wide and not (alert_entry_fips(e) & set(fips)):
+                continue
+            seen.add(key)
+            yield e
+
